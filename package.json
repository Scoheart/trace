{
  "name": "agent-trace-platform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev": "node scripts/start-framework.mjs --dev",
    "build": "next build apps/web",
    "start": "node scripts/start-framework.mjs",
    "typecheck": "tsc --project apps/web/tsconfig.json --noEmit",
    "test": "node --test test/*.test.js",
    "verify": "npm test && npm run typecheck && npm run build",
    "import": "node src/cli.js import",
    "follow": "node src/cli.js follow",
    "legacy:serve": "node src/cli.js serve"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^1.56.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0"
  },
  "description": "Local-first Agent Trace platform: Next.js React TypeScript UI, encrypted evidence, SQLite registry and capture API"
}
